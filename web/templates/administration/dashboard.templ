package administration

import "dorm-man/web/templates/common/components"
import "dorm-man/web/templates/common/partials"

templ DashboardPage() {
	@components.Document("Administration", DashboardContent())
}

templ DashboardContent() {
	@partials.MainNav()
	@components.PageHeader(
		"Administration Module",
		"Central entry point for tenant lifecycle, occupancy, inventory, maintenance, scheduling, publications, and audit flows.",
	)

	<ul>
		<li><a href="/administration/tenants">Tenant Management</a></li>
		<li><a href="/administration/rooms">Room and Capacity</a></li>
		<li><a href="/administration/inventory">Inventory</a></li>
		<li><a href="/administration/maintenance">Maintenance</a></li>
		<li><a href="/administration/jobs">Operational Scheduling</a></li>
		<li><a href="/administration/publications">Publications</a></li>
		<li><a href="/administration/audit">Audit</a></li>
	</ul>
}
