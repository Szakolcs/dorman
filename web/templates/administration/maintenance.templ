package administration

import "dorm-man/web/templates/common/components"
import "dorm-man/web/templates/common/partials"

templ MaintenancePage() {
	@components.AppDocument("Administration - Maintenance", MaintenanceContent())
}

templ MaintenanceContent() {
	@partials.AdministrationNav()
	@components.PageHeader(
		"Maintenance Management",
		"Create, approve, assign, and transition maintenance tickets with full lifecycle tracking.",
	)
	@components.Section("Ticket Filters", MaintenanceFilterForm())
	@components.Section("Ticket List", MaintenanceTable())
	@components.Section("Create Ticket", MaintenanceCreateForm())
	@components.Section("Approve Ticket", MaintenanceApproveForm())
	@components.Section("Transition Ticket", MaintenanceTransitionForm())
}

templ MaintenanceFilterForm() {
	<form method="get" action="/administration/maintenance">
		<label for="ticket-approval-state">Approval State</label>
		<select id="ticket-approval-state" name="approval_state">
			<option value="">All</option>
			<option value="pending">pending</option>
		</select>

		<label for="ticket-status">Status</label>
		<select id="ticket-status" name="status">
			<option value="">All</option>
			<option value="reported">reported</option>
			<option value="in_progress">in_progress</option>
			<option value="halted">halted</option>
			<option value="resolved">resolved</option>
			<option value="closed">closed</option>
		</select>

		<button type="submit">Apply</button>
	</form>
}

templ MaintenanceTable() {
	@components.DataTable([]string{"Ticket", "Category", "Severity", "Status", "Assignee", "Due"}, MaintenanceRows())
}

templ MaintenanceRows() {
	<tr>
		<td>T-001</td>
		<td>incident</td>
		<td>high</td>
		<td>reported</td>
		<td>worker-id</td>
		<td>2026-05-20</td>
	</tr>
}

templ MaintenanceCreateForm() {
	<form method="post" action="/api/administration/maintenance/tickets">
		<label for="ticket-category">Category</label>
		<select id="ticket-category" name="category">
			<option value="yearly">yearly</option>
			<option value="monthly">monthly</option>
			<option value="weekly">weekly</option>
			<option value="incident">incident</option>
		</select>

		<label for="ticket-severity">Severity</label>
		<select id="ticket-severity" name="severity">
			<option value="high">high</option>
			<option value="medium">medium</option>
			<option value="low">low</option>
		</select>

		<label for="ticket-impact">Impact</label>
		<select id="ticket-impact" name="impact">
			<option value="life_threatening">life_threatening</option>
			<option value="affects_daily_life">affects_daily_life</option>
			<option value="inconvenience">inconvenience</option>
			<option value="beauty_flaw">beauty_flaw</option>
		</select>

		<label for="ticket-description">Description</label>
		<textarea id="ticket-description" name="description"></textarea>

		<button type="submit">Create Ticket</button>
	</form>
}

templ MaintenanceApproveForm() {
	<form method="post" action="/api/administration/maintenance/tickets/ticket-id/approve">
		<label for="ticket-assignee-id">Assignee User ID</label>
		<input id="ticket-assignee-id" name="assignee_user_id" type="text"/>

		<label for="ticket-due-at">Due At</label>
		<input id="ticket-due-at" name="due_at" type="datetime-local"/>

		<button type="submit">Approve Ticket</button>
	</form>
}

templ MaintenanceTransitionForm() {
	<form method="post" action="/api/administration/maintenance/tickets/ticket-id/transition">
		<label for="ticket-to-status">To Status</label>
		<select id="ticket-to-status" name="to_status">
			<option value="in_progress">in_progress</option>
			<option value="duplicate">duplicate</option>
			<option value="halted">halted</option>
			<option value="resolved">resolved</option>
			<option value="closed">closed</option>
		</select>

		<label for="ticket-transition-note">Note</label>
		<textarea id="ticket-transition-note" name="note"></textarea>

		<button type="submit">Apply Transition</button>
	</form>
}
