package administration

import "dorm-man/web/templates/common/components"
import "dorm-man/web/templates/common/partials"

templ JobsPage(data JobsPageData) {
	@components.AppDocument("Administration - Jobs", JobsContent(data))
}

templ JobsContent(data JobsPageData) {
	@partials.AdministrationNav()
	@components.PageHeader(
		"Operational Scheduling",
		"Create and review operational jobs with overlap visibility by assignee and date.",
	)
	@components.Section("Job Filters", JobFilterForm(data))
	@components.Section("Job Board", JobTable(data))
	@components.Section("Create Job", JobCreateForm(data))
}

templ JobFilterForm(data JobsPageData) {
	<form method="get" action="/administration/jobs" class="flex max-w-xl flex-col gap-2">
		<label for="job-assignee-id" class="text-sm font-medium text-dm-fg">Assignee</label>
		<select id="job-assignee-id" name="assignee_user_id" class="rounded border border-dm-border bg-dm-bg px-3 py-2">
			<option value="" selected?={ data.AssigneeUserID == "" }>All</option>
			for _, u := range data.StaffUsers {
				<option value={ u.ID.String() } selected?={ data.AssigneeUserID == u.ID.String() }>{ u.Name }</option>
			}
		</select>

		<label for="job-date" class="text-sm font-medium text-dm-fg">Date</label>
		<input id="job-date" name="date" type="date" value={ data.Date } class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>

		<button type="submit" class="w-fit cursor-pointer rounded border border-dm-accent bg-dm-accent px-3 py-2 text-dm-on-accent hover:bg-dm-accent-hover">Apply</button>
	</form>
}

templ JobTable(data JobsPageData) {
	@components.DataTable([]string{"Title", "Assignee", "Starts", "Ends", "Priority", "Status"}, JobRows(data))
	@components.PaginationNav("/administration/jobs", data.Pagination, jobsPreserve(data))
}

templ JobRows(data JobsPageData) {
	if len(data.Jobs) == 0 {
		<tr>
			<td colspan="6">No operational jobs match the current filters.</td>
		</tr>
	}
	for _, j := range data.Jobs {
		<tr>
			<td>{ j.Title }</td>
			<td>{ userName(j.AssigneeUser) }</td>
			<td>{ j.StartsAt.Format("2006-01-02 15:04") }</td>
			<td>{ j.EndsAt.Format("2006-01-02 15:04") }</td>
			<td>{ string(j.Priority) }</td>
			<td>{ string(j.Status) }</td>
		</tr>
	}
}

templ JobCreateForm(data JobsPageData) {
	<form method="post" action="/administration/jobs" class="flex max-w-xl flex-col gap-2">
		<label for="job-title" class="text-sm font-medium text-dm-fg">Title</label>
		<input id="job-title" name="title" type="text" class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>

		<label for="job-description" class="text-sm font-medium text-dm-fg">Description</label>
		<textarea id="job-description" name="description" class="min-h-24 rounded border border-dm-border bg-dm-bg px-3 py-2"></textarea>

		<label for="job-assignee" class="text-sm font-medium text-dm-fg">Assignee</label>
		<select id="job-assignee" name="assignee_user_id" required class="rounded border border-dm-border bg-dm-bg px-3 py-2">
			for _, u := range data.StaffUsers {
				<option value={ u.ID.String() }>{ u.Name }</option>
			}
		</select>

		<label for="job-starts-at" class="text-sm font-medium text-dm-fg">Starts At</label>
		<input id="job-starts-at" name="starts_at" type="datetime-local" class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>

		<label for="job-ends-at" class="text-sm font-medium text-dm-fg">Ends At</label>
		<input id="job-ends-at" name="ends_at" type="datetime-local" class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>

		<label for="job-priority" class="text-sm font-medium text-dm-fg">Priority</label>
		<select id="job-priority" name="priority" class="rounded border border-dm-border bg-dm-bg px-3 py-2">
			<option value="low">low</option>
			<option value="medium">medium</option>
			<option value="high">high</option>
		</select>

		<label for="job-allow-conflict" class="text-sm font-medium text-dm-fg">Allow Overlap</label>
		<select id="job-allow-conflict" name="allow_conflict" class="rounded border border-dm-border bg-dm-bg px-3 py-2">
			<option value="false">false</option>
			<option value="true">true</option>
		</select>

		<button type="submit" class="w-fit cursor-pointer rounded border border-dm-accent bg-dm-accent px-3 py-2 text-dm-on-accent hover:bg-dm-accent-hover">Create Job</button>
	</form>
}
