package administration

import "dorm-man/web/templates/common/components"
import "dorm-man/web/templates/common/partials"

templ JobsPage() {
	@components.AppDocument("Administration - Jobs", JobsContent())
}

templ JobsContent() {
	@partials.AdministrationNav()
	@components.PageHeader(
		"Operational Scheduling",
		"Create and review operational jobs with overlap visibility by assignee and date.",
	)
	@components.Section("Job Filters", JobFilterForm())
	@components.Section("Job Board", JobTable())
	@components.Section("Create Job", JobCreateForm())
}

templ JobFilterForm() {
	<form method="get" action="/administration/jobs">
		<label for="job-assignee-id">Assignee User ID</label>
		<input id="job-assignee-id" name="assignee_user_id" type="text"/>

		<label for="job-date">Date</label>
		<input id="job-date" name="date" type="date"/>

		<button type="submit">Apply</button>
	</form>
}

templ JobTable() {
	@components.DataTable([]string{"Title", "Assignee", "Starts", "Ends", "Priority", "Status"}, JobRows())
}

templ JobRows() {
	<tr>
		<td>Inventory Audit</td>
		<td>worker-id</td>
		<td>2026-05-22T09:00</td>
		<td>2026-05-22T11:00</td>
		<td>high</td>
		<td>planned</td>
	</tr>
}

templ JobCreateForm() {
	<form method="post" action="/api/administration/jobs">
		<label for="job-title">Title</label>
		<input id="job-title" name="title" type="text"/>

		<label for="job-description">Description</label>
		<textarea id="job-description" name="description"></textarea>

		<label for="job-assignee">Assignee User ID</label>
		<input id="job-assignee" name="assignee_user_id" type="text"/>

		<label for="job-starts-at">Starts At</label>
		<input id="job-starts-at" name="starts_at" type="datetime-local"/>

		<label for="job-ends-at">Ends At</label>
		<input id="job-ends-at" name="ends_at" type="datetime-local"/>

		<label for="job-priority">Priority</label>
		<select id="job-priority" name="priority">
			<option value="low">low</option>
			<option value="medium">medium</option>
			<option value="high">high</option>
		</select>

		<label for="job-allow-conflict">Allow Overlap</label>
		<select id="job-allow-conflict" name="allow_conflict">
			<option value="false">false</option>
			<option value="true">true</option>
		</select>

		<button type="submit">Create Job</button>
	</form>
}
