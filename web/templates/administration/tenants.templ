package administration

import "dorm-man/web/templates/common/components"
import "dorm-man/web/templates/common/partials"

templ TenantsPage(data TenantsPageData) {
	@components.AppDocument("Administration - Tenants", TenantsContent(data))
}

templ TenantsContent(data TenantsPageData) {
	@partials.AdministrationNav()
	@components.PageHeader(
		"Tenant Management",
		"Register, activate, deactivate, and review tenant details for the semester lifecycle.",
	)
	@components.Section("Directory Filters", TenantsFilters(data))
	@components.Section("Tenant Directory", TenantsDirectory(data))
	@components.Section("Register New Tenant", TenantRegistrationForm())
}

templ TenantsFilters(data TenantsPageData) {
	<form method="get" action="/administration/tenants">
		<label for="tenant-search">Search</label>
		<input id="tenant-search" name="search" type="text" value={ data.Search }/>

		<label for="tenant-status">Status</label>
		<select id="tenant-status" name="status">
			<option value="" selected?={ data.Status == "" }>All</option>
			<option value="active" selected?={ data.Status == "active" }>Active</option>
			<option value="inactive" selected?={ data.Status == "inactive" }>Inactive</option>
		</select>

		<button type="submit">Apply</button>
	</form>
}

templ TenantsDirectory(data TenantsPageData) {
	@components.DataTable([]string{"Name", "Student Code", "Email", "Status", "Actions"}, TenantRows(data))
	@components.PaginationNav("/administration/tenants", data.Pagination, tenantsPreserve(data))
}

templ TenantRows(data TenantsPageData) {
	if len(data.Tenants) == 0 {
		<tr>
			<td colspan="5">No tenants match the current filters.</td>
		</tr>
	}
	for _, t := range data.Tenants {
		<tr>
			<td>{ t.Name }</td>
			<td>{ t.StudentCode }</td>
			<td>{ t.Email }</td>
			<td>{ tenantStatus(t.IsActive) }</td>
			<td>
				<a href={ templ.SafeURL("/administration/tenants/" + t.ID.String()) }>Details</a>
				if t.IsActive {
					<form method="post" action={ templ.SafeURL("/administration/tenants/" + t.ID.String() + "/deactivate") }>
						<button type="submit">Deactivate</button>
					</form>
				}
			</td>
		</tr>
	}
}

templ TenantRegistrationForm() {
	<form method="post" action="/administration/tenants">
		<label for="tenant-name">Name</label>
		<input id="tenant-name" name="name" type="text"/>

		<label for="tenant-student-code">Student Code</label>
		<input id="tenant-student-code" name="student_code" type="text"/>

		<label for="tenant-email">Email</label>
		<input id="tenant-email" name="email" type="email"/>

		<label for="tenant-nationality">Nationality</label>
		<select id="tenant-nationality" name="nationality">
			<option value="hungarian">Hungarian</option>
			<option value="international">International</option>
		</select>

		<button type="submit">Register Tenant</button>
	</form>
}
