package administration

import "dorm-man/web/templates/common/components"
import "dorm-man/web/templates/common/partials"

templ TenantsPage(data TenantsPageData) {
	@components.AppDocument("Administration - Tenants", TenantsContent(data))
}

templ TenantsContent(data TenantsPageData) {
	@partials.AdministrationNav()
	@components.PageHeader(
		"Tenant Management",
		"Register, activate, deactivate, and review tenant details for the semester lifecycle.",
	)
	@components.Section("Directory Filters", TenantsFilters(data))
	@components.Section("Tenant Directory", TenantsDirectory(data))
	@components.Section("Register New Tenant", TenantRegistrationForm())
}

templ TenantsFilters(data TenantsPageData) {
	<form method="get" action="/administration/tenants" class="flex max-w-xl flex-col gap-2">
		<label for="tenant-search" class="text-sm font-medium text-dm-fg">Search</label>
		<input id="tenant-search" name="search" type="text" value={ data.Search } class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>

		<label for="tenant-status" class="text-sm font-medium text-dm-fg">Status</label>
		<select id="tenant-status" name="status" class="rounded border border-dm-border bg-dm-bg px-3 py-2">
			<option value="" selected?={ data.Status == "" }>All</option>
			<option value="active" selected?={ data.Status == "active" }>Active</option>
			<option value="inactive" selected?={ data.Status == "inactive" }>Inactive</option>
		</select>

		<button type="submit" class="w-fit cursor-pointer rounded border border-dm-accent bg-dm-accent px-3 py-2 text-dm-on-accent hover:bg-dm-accent-hover">Apply</button>
	</form>
}

templ TenantsDirectory(data TenantsPageData) {
	@components.DataTable([]string{"Name", "Student Code", "Email", "Status", "Actions"}, TenantRows(data))
	@components.PaginationNav("/administration/tenants", data.Pagination, tenantsPreserve(data))
}

templ TenantRows(data TenantsPageData) {
	if len(data.Tenants) == 0 {
		<tr>
			<td colspan="5">No tenants match the current filters.</td>
		</tr>
	}
	for _, t := range data.Tenants {
		<tr>
			<td>{ t.Name }</td>
			<td>{ t.StudentCode }</td>
			<td>{ t.Email }</td>
			<td>{ tenantStatus(t.IsActive) }</td>
			<td>
				<a href={ templ.SafeURL("/administration/tenants/" + t.ID.String()) }>Details</a>
				if t.IsActive {
					<form method="post" action={ templ.SafeURL("/administration/tenants/" + t.ID.String() + "/deactivate") } class="mt-1 inline">
						<button type="submit" class="cursor-pointer rounded border border-dm-accent bg-dm-accent px-2 py-1 text-sm text-dm-on-accent hover:bg-dm-accent-hover">Deactivate</button>
					</form>
				}
			</td>
		</tr>
	}
}

templ TenantRegistrationForm() {
	<form method="post" action="/administration/tenants" class="flex max-w-xl flex-col gap-2">
		<label for="tenant-name" class="text-sm font-medium text-dm-fg">Name</label>
		<input id="tenant-name" name="name" type="text" class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>

		<label for="tenant-student-code" class="text-sm font-medium text-dm-fg">Student Code</label>
		<input id="tenant-student-code" name="student_code" type="text" class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>

		<label for="tenant-email" class="text-sm font-medium text-dm-fg">Email</label>
		<input id="tenant-email" name="email" type="email" class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>

		<label for="tenant-nationality" class="text-sm font-medium text-dm-fg">Nationality</label>
		<select id="tenant-nationality" name="nationality" class="rounded border border-dm-border bg-dm-bg px-3 py-2">
			<option value="hungarian">Hungarian</option>
			<option value="international">International</option>
		</select>

		<button type="submit" class="w-fit cursor-pointer rounded border border-dm-accent bg-dm-accent px-3 py-2 text-dm-on-accent hover:bg-dm-accent-hover">Register Tenant</button>
	</form>
}
