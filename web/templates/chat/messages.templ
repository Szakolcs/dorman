package chat

import cm "dorm-man/internal/models/chat"

templ MessageListPartial(actorTenantID string, roomID string, messages []cm.ChatMessage) {
	<div
		id="chat-message-list"
		hx-get={ chatHref("/chat/view/rooms/"+roomID+"/messages", actorTenantID) }
		hx-trigger="every 3s"
		hx-swap="outerHTML"
		hx-include="#chat-actor-bar, #chat-actor-tenant-id"
	>
		@MessageListBody(messages)
	</div>
}

templ MessageListBody(messages []cm.ChatMessage) {
	<ul id="message-list" class="mb-4 list-none space-y-0 p-0">
		for _, msg := range messages {
			@MessageItem(msg)
		}
	</ul>
	if len(messages) == 0 {
		<p class="text-dm-muted">No messages yet.</p>
	}
}

templ MessageItem(msg cm.ChatMessage) {
	<li id={ "msg-" + msg.ID.String() } class="border-b border-dm-border py-2 last:border-b-0">
		<strong>{ msg.AuthorTenant.Name }</strong>
		<time datetime={ msg.CreatedAt.Format("2006-01-02T15:04:05Z07:00") } class="block text-xs text-dm-muted">
			{ msg.CreatedAt.Format("2006-01-02 15:04") }
		</time>
		<p class="mt-1">{ msg.Body }</p>
	</li>
}

templ SendMessageForm(actorTenantID string, roomID string, clientMessageID string) {
	<form
		id="chat-send-form"
		hx-post={ chatHref("/chat/view/rooms/"+roomID+"/messages", actorTenantID) }
		hx-target="#message-list"
		hx-swap="beforeend"
		hx-include="#chat-actor-bar, #chat-actor-tenant-id"
		hx-on::after-request="if(event.detail.successful) this.reset()"
		class="flex max-w-none flex-col gap-2"
	>
		<input type="hidden" name="client_message_id" value={ clientMessageID }/>
		<label for="body" class="text-sm font-medium text-dm-fg">Message</label>
		<textarea id="body" name="body" rows="3" required class="rounded border border-dm-border bg-dm-bg px-3 py-2"></textarea>
		<button type="submit" class="w-fit cursor-pointer rounded border border-dm-accent bg-dm-accent px-3 py-2 text-dm-on-accent hover:bg-dm-accent-hover">
			Send
		</button>
	</form>
}

templ RoomError(message string) {
	<p class="my-4 rounded border border-dm-error bg-dm-error/10 px-4 py-2 text-dm-error" role="alert">{ message }</p>
}
