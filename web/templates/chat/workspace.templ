package chat

import "dorm-man/web/templates/common/components"

templ WorkspacePage(actorTenantID string) {
	@ChatShell("Chat", actorTenantID, WorkspaceBody(actorTenantID))
}

templ WorkspaceBody(actorTenantID string) {
	@components.PageHeader(
		"Chat workspace",
		"Flat, direct, and group conversations with near real-time message updates.",
	)
	<div id="chat-workspace">
		@components.Section("Conversations", ConversationListLoader(actorTenantID))
		<section id="chat-room-panel" aria-live="polite">
			<h2>Room</h2>
			<p>Select a conversation or open a direct message.</p>
		</section>
	</div>
}

templ RoomPage(actorTenantID string, body templ.Component) {
	@ChatShell("Chat room", actorTenantID, body)
}

templ ConversationListLoader(actorTenantID string) {
	<div
		id="chat-conversation-list"
		hx-get={ chatHref("/chat/view/conversations", actorTenantID) }
		hx-trigger="load"
		hx-swap="outerHTML"
		hx-include="#chat-actor-bar, #chat-actor-tenant-id"
	>
		<p>Loading conversations…</p>
	</div>
}
