package forum

import (
	"dorm-man/web/templates/common/components"
	fm "dorm-man/internal/models/forum"
)

templ FeedPage(data FeedPageData) {
	@ForumDocument("Forum", data.ActorUserID, FeedPageBody(data))
}

templ FeedPageBody(data FeedPageData) {
	@components.PageHeader(
		"Forum feed",
		"Official news, community activities, events, and polls.",
	)
	@components.Section("Filters", FeedFilters(data))
	@components.Section("New community activity", CommunityPostForm())
	@components.Section("Posts", FeedListContainer(data))
}

templ FeedListContainer(data FeedPageData) {
	<div id="feed-list">
		@FeedListFragment(data)
	</div>
}

templ FeedListFragment(data FeedPageData) {
	@FeedList(data.Posts)
	@components.PaginationNav("/forum/view", data.Pagination, data.Preserve)
}

templ FeedFilters(data FeedPageData) {
	<form
		id="feed-filters"
		hx-get="/forum/view/feed"
		hx-target="#feed-list"
		hx-swap="innerHTML"
		hx-trigger="change, submit"
		hx-include="#forum-actor-bar"
		class="flex max-w-xl flex-col gap-2"
	>
		<label for="sort" class="text-sm font-medium text-dm-fg">Sort</label>
		<select id="sort" name="sort" class="rounded border border-dm-border bg-dm-bg px-3 py-2">
			<option value="newest" selected?={ data.Sort == "newest" }>Newest</option>
			<option value="pinned_first" selected?={ data.Sort == "pinned_first" }>Pinned first</option>
		</select>
		<label for="kind" class="text-sm font-medium text-dm-fg">Kind</label>
		<select id="kind" name="kind" class="rounded border border-dm-border bg-dm-bg px-3 py-2">
			<option value="" selected?={ data.Kind == "" }>All kinds</option>
			<option value="official_news" selected?={ data.Kind == "official_news" }>Official news</option>
			<option value="community_activity" selected?={ data.Kind == "community_activity" }>Community activity</option>
			<option value="event" selected?={ data.Kind == "event" }>Event</option>
			<option value="poll" selected?={ data.Kind == "poll" }>Poll</option>
			<option value="announcement" selected?={ data.Kind == "announcement" }>Announcement</option>
		</select>
		<label class="flex items-center gap-2 text-sm">
			<input type="checkbox" name="official_only" value="true" checked?={ data.OfficialOnly }/>
			Official only
		</label>
		<label class="flex items-center gap-2 text-sm">
			<input type="checkbox" name="community_only" value="true" checked?={ data.CommunityOnly }/>
			Community only
		</label>
		<button type="submit" class="w-fit cursor-pointer rounded border border-dm-accent bg-dm-accent px-3 py-2 text-dm-on-accent hover:bg-dm-accent-hover">Apply</button>
	</form>
}

templ FeedList(posts []fm.ForumPost) {
	if len(posts) == 0 {
		<p>No posts in the feed.</p>
	}
	<ul class="list-none space-y-3 p-0">
		for _, post := range posts {
			@FeedPostItem(post)
		}
	</ul>
}

templ FeedPostItem(post fm.ForumPost) {
	<li class="rounded border border-dm-border bg-dm-bg p-4 hover:border-dm-accent">
		<article>
			<h3>
				<a href={ templ.SafeURL("/forum/view/posts/" + post.ID.String()) } hx-boost="true">
					{ post.Title }
				</a>
			</h3>
			<p>
				<span>{ string(post.Kind) }</span>
				if post.PublishedAt != nil {
					<time datetime={ post.PublishedAt.Format("2006-01-02T15:04:05Z07:00") }>
						{ post.PublishedAt.Format("2006-01-02 15:04") }
					</time>
				}
			</p>
			<p>{ post.Body }</p>
		</article>
	</li>
}

templ CommunityPostForm() {
	<form
		hx-post="/forum/view/posts"
		hx-target="#feed-list"
		hx-swap="innerHTML"
		hx-include="#forum-actor-bar"
		class="flex max-w-xl flex-col gap-2"
	>
		<label for="cp-title" class="text-sm font-medium text-dm-fg">Title</label>
		<input id="cp-title" type="text" name="title" required class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>

		<label for="cp-body" class="text-sm font-medium text-dm-fg">Description</label>
		<textarea id="cp-body" name="body" required class="min-h-24 rounded border border-dm-border bg-dm-bg px-3 py-2"></textarea>

		<label for="cp-location" class="text-sm font-medium text-dm-fg">Location</label>
		<input id="cp-location" type="text" name="location" class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>

		<label for="cp-starts" class="text-sm font-medium text-dm-fg">Starts at</label>
		<input id="cp-starts" type="datetime-local" name="starts_at" class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>

		<label for="cp-ends" class="text-sm font-medium text-dm-fg">Ends at</label>
		<input id="cp-ends" type="datetime-local" name="ends_at" class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>

		<label for="cp-tags" class="text-sm font-medium text-dm-fg">Tags</label>
		<input id="cp-tags" type="text" name="tags" class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>

		<label class="flex items-center gap-2 text-sm">
			<input type="checkbox" name="publish" value="true"/>
			Publish immediately
		</label>

		<button type="submit" class="w-fit cursor-pointer rounded border border-dm-accent bg-dm-accent px-3 py-2 text-dm-on-accent hover:bg-dm-accent-hover">
			Create community activity
		</button>
	</form>
}
