package forum

import (
	"dorm-man/web/templates/common/components"
	"dorm-man/web/templates/common/partials"
)

templ ForumDocument(title string, actorUserID string, body templ.Component) {
	@components.Document(title, ForumDocumentBody(actorUserID, body))
}

templ ForumDocumentBody(actorUserID string, body templ.Component) {
	@partials.MainNav()
	@ForumNav()
	if actorUserID == "" {
		@ActorStubForm()
	} else {
		@components.DevActorField(
			"forum-actor-bar",
			"Development stub: staff/tenant user principal for forum actions.",
			"actor_user_id",
			"actor_user_id",
			actorUserID,
		)
		@body
	}
}

templ ForumNav() {
	<nav class="mb-4 -mt-2 flex flex-wrap items-center gap-2 gap-x-4 rounded-lg border border-dm-border bg-dm-surface px-4 py-2 pt-2">
		<a href="/forum/view" class="text-dm-link no-underline hover:text-dm-accent-hover hover:underline" hx-boost="true">Feed</a>
	</nav>
}

templ ActorStubForm() {
	@components.PageHeader(
		"Forum",
		"Select an actor user (development stub). Use header X-Actor-User-ID or the field below.",
	)
	<form method="get" action="/forum/view" class="flex max-w-xl flex-col gap-2">
		<label for="actor_user_id" class="text-sm font-medium text-dm-fg">User ID</label>
		<input id="actor_user_id" name="actor_user_id" type="text" required class="rounded border border-dm-border bg-dm-bg px-3 py-2"/>
		<button type="submit" class="w-fit cursor-pointer rounded border border-dm-accent bg-dm-accent px-3 py-2 text-dm-on-accent hover:bg-dm-accent-hover">
			Open forum
		</button>
	</form>
}

templ ErrorAlert(message string) {
	@components.ErrorAlert(message)
}

templ ForumEmptyBody() {
}
