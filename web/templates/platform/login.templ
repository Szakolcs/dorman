package platform

import "dorm-man/web/templates/common/components"

templ LoginPage(errorMessage string) {
	@components.AppDocument("Login", LoginContent(errorMessage))
}

templ LoginContent(errorMessage string) {
	@components.PageHeader(
		"Platform Login",
		"Sign in and get redirected to your module based on your role.",
	)
	if errorMessage != "" {
		@components.ErrorAlert(errorMessage)
	}
	<form method="post" action="/home/login?redirect=true">
		<label for="login-email">Email</label>
		<input id="login-email" name="email" type="email" required/>

		<label for="login-password">Password</label>
		<input id="login-password" name="password" type="password" required/>

		<button type="submit">Login</button>
	</form>
}
