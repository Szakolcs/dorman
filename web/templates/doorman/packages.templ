package doorman

import (
	dm "dorm-man/internal/models/doorman"
)

import "dorm-man/web/templates/common/components"
import "dorm-man/web/templates/common/partials"

templ PackagesPage(data PackagesPageData) {
	@components.AppDocument("Doorman - Packages", PackagesContent(data))
}

templ PackagesContent(data PackagesPageData) {
	@components.PageHeader(
		"Packages",
		"Inbound parcels: register with optional tenant mapping, lifecycle received → notified (optional) → picked up.",
	)
	@partials.DoormanNav()
	@components.BackLink("/doorman", "Back to Doorman")

	@components.Section("Recent parcels", PackagesTable(data))
	@components.Section("Parcel intake", PackageRegisterForm(data))
}

templ PackagesTable(data PackagesPageData) {
	@components.DataTable([]string{"Recipient", "Tenant", "Status", "Received", "Actions"}, PackageRows(data))
	@components.PaginationNav("/doorman/packages", data.Pagination, map[string]string{})
}

templ PackageRows(data PackagesPageData) {
	if len(data.Packages) == 0 {
		<tr>
			<td colspan="5">No packages in the database.</td>
		</tr>
	}
	for _, p := range data.Packages {
		<tr>
			<td>{ p.RecipientLabel }</td>
			<td>{ packageTenantLabel(p) }</td>
			<td>{ string(p.Status) }</td>
			<td>{ p.ReceivedAt.Format("2006-01-02 15:04") }</td>
			<td>
				@PackageRowActions(p)
			</td>
		</tr>
	}
}

templ PackageRowActions(p dm.Package) {
	if p.Status != dm.PackageStatusPickedUp {
		<form method="post" action={ templ.SafeURL("/doorman/packages/" + p.ID.String() + "/pickup") } class="inline-form">
			<button type="submit">Pickup</button>
		</form>
		if p.Status == dm.PackageStatusReceived {
			<form method="post" action={ templ.SafeURL("/doorman/packages/" + p.ID.String() + "/notify") } class="inline-form">
				<input type="hidden" name="channel" value="email"/>
				<button type="submit">Notify</button>
			</form>
		}
	}
}

templ PackageRegisterForm(data PackagesPageData) {
	<form method="post" action="/doorman/packages">
		<label for="pkg-recipient">Recipient label</label>
		<input id="pkg-recipient" type="text" name="recipient_label" required/>

		<label for="pkg-desc">Description</label>
		<input id="pkg-desc" type="text" name="description"/>

		<label for="pkg-tenant">Tenant (optional)</label>
		<select id="pkg-tenant" name="tenant_id">
			<option value="">—</option>
			for _, t := range data.Tenants {
				<option value={ t.ID.String() }>{ t.Name }</option>
			}
		</select>

		<button type="submit">Register parcel</button>
	</form>
}
