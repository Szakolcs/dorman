package doorman

import "dorm-man/web/templates/common/components"
import "dorm-man/web/templates/common/partials"

templ AccessPage() {
	@components.AppDocument("Doorman - Access", AccessContent())
}

templ AccessContent() {
	@components.PageHeader(
		"Dorm entry verification",
		"QR or manual verification creates immutable access rows; denial reasons include invalid, expired, revoked.",
	)
	@partials.DoormanNav()
	@components.BackLink("/doorman", "Back to Doorman")

	@components.Section(
		"Tenant entry token (mint)",
		IssueEntryTokenForm(),
	)

	@components.Section(
		"Validate QR payload",
		ValidateQRDocs(),
	)

	@components.Section(
		"Manual verification",
		ValidateManualDocs(),
	)

	@components.Section(
		"Access event log filters",
		AccessEventsFilters(),
	)
}

templ IssueEntryTokenForm() {
	<p>POST JSON <code>/api/doorman/tenant-entry-tokens</code>.</p>
	<form method="post" action="/api/doorman/tenant-entry-tokens">
		<label for="tok-tenant">Tenant UUID</label>
		<input id="tok-tenant" type="text" name="tenant_id"/>

		<label for="tok-ref">Public ref (optional)</label>
		<input id="tok-ref" type="text" name="public_ref" placeholder="empty = server-generated"/>

		<label for="tok-exp">Expires at (RFC3339, optional)</label>
		<input id="tok-exp" type="text" name="expires_at"/>

		<button type="submit">Issue (placeholder — use JSON)</button>
	</form>
}

templ ValidateQRDocs() {
	<p>POST <code>/api/doorman/access/validate-qr</code></p>
	<pre>{ `{"public_ref":"token-from-qr-or-scanner"}` }</pre>
	<p>Response lists <code>outcome</code> granted or denied, optional <code>reason</code>, linked <code>event</code> id, tenant snapshot when granted.</p>
}

templ ValidateManualDocs() {
	<p>POST <code>/api/doorman/access/validate-manual</code></p>
	<pre>{ `{"tenant_id":"UUID"}` }</pre>
}

templ AccessEventsFilters() {
	<p>GET <code>/api/doorman/access/events</code> query params:</p>
	<ul>
		<li><code>tenant_id</code></li>
		<li><code>from</code>, <code>to</code> RFC3339</li>
		<li><code>outcome=granted|denied</code></li>
		<li><code>limit</code>, <code>offset</code></li>
	</ul>
}
