package doorman

import "dorm-man/web/templates/common/components"
import "dorm-man/web/templates/common/partials"

templ LendingPage(data LendingPageData) {
	@components.AppDocument("Doorman - Lending", LendingContent(data))
}

templ LendingContent(data LendingPageData) {
	@components.PageHeader(
		"Keys and accessories",
		"Checkout to a tenant, return closes the loan; at most one open loan per lendable inventory row in this MVP.",
	)
	@partials.DoormanNav()
	@components.BackLink("/doorman", "Back to Doorman")

	@components.Section("Recent loans", ItemLoansTable(data))
	@components.Section("Checkout", LendingCheckoutForm(data))
}

templ ItemLoansTable(data LendingPageData) {
	@components.DataTable([]string{"Item", "Tenant", "Checked out", "Returned", "Status", "Actions"}, ItemLoanRows(data))
	@components.PaginationNav("/doorman/lending", data.Pagination, map[string]string{})
}

templ ItemLoanRows(data LendingPageData) {
	if len(data.Loans) == 0 {
		<tr>
			<td colspan="6">No item loans in the database.</td>
		</tr>
	}
	for _, loan := range data.Loans {
		<tr>
			<td>{ loanItemName(loan) }</td>
			<td>{ loanTenantName(loan) }</td>
			<td>{ loan.CheckedOutAt.Format("2006-01-02 15:04") }</td>
			<td>{ optionalTime(loan.ReturnedAt) }</td>
			<td>{ loanStatus(loan) }</td>
			<td>
				if loan.ReturnedAt == nil {
					<form method="post" action={ templ.SafeURL("/doorman/lending/" + loan.ID.String() + "/return") } class="inline-form">
						<button type="submit">Return</button>
					</form>
				}
			</td>
		</tr>
	}
}

templ LendingCheckoutForm(data LendingPageData) {
	<form method="post" action="/doorman/lending">
		<label for="loan-tenant">Tenant</label>
		<select id="loan-tenant" name="tenant_id" required>
			for _, t := range data.Tenants {
				<option value={ t.ID.String() }>{ t.Name }</option>
			}
		</select>

		<label for="loan-item">Inventory item</label>
		<select id="loan-item" name="inventory_item_id" required>
			for _, item := range data.Inventory {
				<option value={ item.ID.String() }>{ item.Name }</option>
			}
		</select>

		<label for="loan-expect">Expected return (RFC3339, optional)</label>
		<input id="loan-expect" type="text" name="expected_return_at"/>

		<label for="loan-notes">Notes</label>
		<input id="loan-notes" type="text" name="notes"/>

		<button type="submit">Checkout</button>
	</form>
}
