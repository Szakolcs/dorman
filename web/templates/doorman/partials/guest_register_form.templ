package doormanviews

import "dorm-man/internal/models"

templ GuestRegisterForm(tenants []models.Tenant) {
	<tr>
		<form
			hx-post="/doorman/register/guest"
			hx-target="#guest-table"
			hx-swap="outerHTML"
		>
			<td class="p-3">
				<input
					type="text"
					name="guest_name"
					placeholder="Guest Name"
					class="dm-input w-full"
				/>
			</td>
			<td class="p-3">
				<input
					type="text"
					name="id_notes"
					placeholder="ID Notes"
					class="dm-input w-full"
				/>
			</td>
			<td class="p-3">
				checked_in
			</td>
			<td class="p-3">
				<select
					name="host_tenant_id"
					class="dm-input w-full"
				>
					for _, tenant := range tenants {
						<option value={ tenant.ID.String() }>
							{ tenant.User.Name }
						</option>
					}
				</select>
			</td>
			<td class="p-3">
				<button
					type="submit"
					class="dm-button"
				>
					Create
				</button>
			</td>
		</form>
	</tr>
}