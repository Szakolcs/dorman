package doormanviews

import (
	"dorm-man/internal/models"
	"dorm-man/web/templates/common/partials"
)

templ AccessForm(tenants []models.Tenant) {
	<form
		hx-get="/doorman/access/tenant"
		hx-target="#last-five"
		hx-swap="outerHTML"
		class={ partials.Cls.FilterBar }
	>
		<select
			id="tenant"
			name="id"
			class={ partials.Cls.Select }
		>
			for _, tenant := range tenants {
				<option value={ tenant.ID.String() }>
					@TenantLabel(tenant)
				</option>
			}
		</select>
		<select
			id="direction"
			name="direction"
			class={ partials.Cls.Select }
		>
			<option value="checked_in">
				Checked In
			</option>
			<option value="checked_out">
				Checked Out
			</option>
		</select>
		<button
			type="submit"
			class={ partials.Cls.Button }
		>
			Register
		</button>
	</form>
}
