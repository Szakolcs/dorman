package doorman

import "dorm-man/web/templates/common/components"
import "dorm-man/web/templates/common/partials"

templ DashboardPage() {
	@components.Document("Doorman", DashboardContent())
}

templ DashboardContent() {
	@partials.MainNav()
	@components.PageHeader(
		"Doorman Module",
		"Front-desk workflows: parcel intake and pickup, guest visits, dorm entry verification, and lendable inventory.",
	)
	<ul>
		<li><a href="/doorman/packages">Packages</a>: intake, lifecycle, pickup, tenant notifications.</li>
		<li><a href="/doorman/guests">Guests</a>: visits, validity window, check-in and check-out.</li>
		<li><a href="/doorman/access">Access</a>: QR and manual verification, tenant entry tokens, access log.</li>
		<li><a href="/doorman/lending">Lending</a>: checkout, return, open and overdue loans.</li>
	</ul>
}
