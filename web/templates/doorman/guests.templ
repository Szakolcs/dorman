package doorman

import (
	dm "dorm-man/internal/models/doorman"
)

import "dorm-man/web/templates/common/components"
import "dorm-man/web/templates/common/partials"

templ GuestsPage(data GuestsPageData) {
	@components.AppDocument("Doorman - Guests", GuestsContent(data))
}

templ GuestsContent(data GuestsPageData) {
	@components.PageHeader(
		"Guest access desk",
		"Visitors linked to a host tenant and validity window; check-in only inside window; denial logged outside.",
	)
	@partials.DoormanNav()
	@components.BackLink("/doorman", "Back to Doorman")

	@components.Section("Recent guest visits", GuestVisitsTable(data))
	@components.Section("Register a guest visit", GuestRegisterForm(data))
}

templ GuestVisitsTable(data GuestsPageData) {
	@components.DataTable([]string{"Guest", "Host", "Valid from", "Valid to", "Status", "Actions"}, GuestVisitRows(data))
	@components.PaginationNav("/doorman/guests", data.Pagination, map[string]string{})
}

templ GuestVisitRows(data GuestsPageData) {
	if len(data.Visits) == 0 {
		<tr>
			<td colspan="6">No guest visits in the database.</td>
		</tr>
	}
	for _, v := range data.Visits {
		<tr>
			<td>{ v.GuestName }</td>
			<td>{ guestHostName(v) }</td>
			<td>{ v.ValidFrom.Format("2006-01-02 15:04") }</td>
			<td>{ v.ValidTo.Format("2006-01-02 15:04") }</td>
			<td>{ string(v.Status) }</td>
			<td>
				@GuestVisitActions(v)
			</td>
		</tr>
	}
}

templ GuestVisitActions(v dm.GuestVisit) {
	if v.Status == dm.GuestVisitStatusScheduled {
		<form method="post" action={ templ.SafeURL("/doorman/guests/" + v.ID.String() + "/check-in") } class="inline-form">
			<button type="submit">Check in</button>
		</form>
	}
	if v.Status == dm.GuestVisitStatusCheckedIn {
		<form method="post" action={ templ.SafeURL("/doorman/guests/" + v.ID.String() + "/check-out") } class="inline-form">
			<button type="submit">Check out</button>
		</form>
	}
}

templ GuestRegisterForm(data GuestsPageData) {
	<form method="post" action="/doorman/guests">
		<label for="guest-host">Host tenant</label>
		<select id="guest-host" name="host_tenant_id" required>
			for _, t := range data.Tenants {
				<option value={ t.ID.String() }>{ t.Name }</option>
			}
		</select>

		<label for="guest-name">Guest name</label>
		<input id="guest-name" type="text" name="guest_name" required/>

		<label for="guest-notes">ID / notes</label>
		<input id="guest-notes" type="text" name="id_notes"/>

		<label for="guest-from">Valid from (RFC3339)</label>
		<input id="guest-from" type="text" name="valid_from" placeholder="2026-05-01T09:00:00Z" required/>

		<label for="guest-to">Valid to (RFC3339)</label>
		<input id="guest-to" type="text" name="valid_to" placeholder="2026-05-01T21:00:00Z" required/>

		<button type="submit">Register visit</button>
	</form>
}
