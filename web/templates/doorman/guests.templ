package doorman

import "dorm-man/web/templates/common/components"
import "dorm-man/web/templates/common/partials"

templ GuestsPage() {
	@components.AppDocument("Doorman - Guests", GuestsContent())
}

templ GuestsContent() {
	@components.PageHeader(
		"Guest access desk",
		"Visitors linked to a host tenant and validity window; check-in only inside window; denial logged outside.",
	)
	@partials.DoormanNav()
	@components.BackLink("/doorman", "Back to Doorman")

	@components.Section(
		"Today's visit list",
		GuestFiltersHint(),
	)

	@components.Section(
		"Register a guest visit",
		GuestRegisterForm(),
	)

	@components.Section(
		"Check-in and check-out",
		GuestCheckForms(),
	)
}

templ GuestFiltersHint() {
	<p>List visits overlapping a calendar day:</p>
	<pre>GET /api/doorman/guest-visits?on=YYYY-MM-DD</pre>
}

templ GuestRegisterForm() {
	<p>POST JSON <code>/api/doorman/guest-visits</code> (<code>X-Actor-User-ID</code>).</p>
	<form method="post" action="/api/doorman/guest-visits">
		<label for="guest-host">Host tenant UUID</label>
		<input id="guest-host" type="text" name="host_tenant_id"/>

		<label for="guest-name">Guest name</label>
		<input id="guest-name" type="text" name="guest_name"/>

		<label for="guest-notes">ID / notes</label>
		<input id="guest-notes" type="text" name="id_notes"/>

		<label for="guest-from">Valid from (RFC3339)</label>
		<input id="guest-from" type="text" name="valid_from" placeholder="2026-05-01T09:00:00Z"/>

		<label for="guest-to">Valid to (RFC3339)</label>
		<input id="guest-to" type="text" name="valid_to" placeholder="2026-05-01T21:00:00Z"/>

		<button type="submit">Register (placeholder — use JSON)</button>
	</form>
}

templ GuestCheckForms() {
	<p>For visit id <code>UUID</code>:</p>
	<ul>
		<li><code>{ `POST /api/doorman/guest-visits/{id}/check-in` }</code> — denies with <code>outside_visit_window</code> outside range</li>
		<li><code>{ `POST /api/doorman/guest-visits/{id}/check-out` }</code></li>
		<li><code>{ `GET /api/doorman/guest-visits/{id}` }</code> — details and access event history</li>
	</ul>
	<form method="get" action="#">
		<label for="visit-id">Visit UUID reference</label>
		<input id="visit-id" type="text" placeholder="guest visit id"/>
	</form>
}
