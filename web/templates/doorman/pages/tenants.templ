package doormanviews

import (
	"dorm-man/internal/models"
	dv "dorm-man/web/templates/doorman/partials"
)

templ TenantAccessPage(entries []models.TenantEntry) {
	@dv.Layout("Tenant Access") {
		@dv.Navigation()
		<div class="space-y-6">
			<div>
				<h1 class="mb-2 text-3xl font-bold">
					Tenant Access
				</h1>
				<p class="text-dm-muted">
					View and filter tenant access history.
				</p>
			</div>
			@dv.TenantAccessFilters()
			<div
				id="tenant-access-table"
				class="dm-card"
			>
				@dv.TenantAccessTable(entries)
			</div>
		</div>
	}
}