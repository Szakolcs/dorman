package maintenanceviews

import (
	models "dorm-man/internal/models/maintenance"
	"dorm-man/web/templates/common/partials"
)

templ TenantDashboardPage(tickets []models.Ticket) {
	@Layout("My Maintenance Tickets") {
		@TenantNavigation()
		<div class="space-y-6">
			<div>
				<h1 class="mb-2 text-3xl font-bold">
					My Maintenance Tickets
				</h1>
				<p class="text-dm-muted">
					Report issues and track your maintenance requests.
				</p>
			</div>
			@partials.Card("Report an Issue") {
				@TicketCreateForm()
			}
			@partials.Card("Your Tickets") {
				@TicketTable(tickets, "/tenant/tickets/")
			}
		</div>
	}
}
