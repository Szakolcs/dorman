package maintenanceviews

import (
	models "dorm-man/internal/models/maintenance"
	"dorm-man/web/templates/common/partials"
)

templ TicketDetailPage(ticket models.Ticket) {
	@Layout("Ticket Detail") {
		@StaffNavigation()
		<div class="space-y-6">
			<div>
				<h1 class="mb-2 text-3xl font-bold">
					Ticket Detail
				</h1>
				<p class="text-dm-muted">
					Reported { ticket.CreatedAt.Format("2006-01-02 15:04") }
				</p>
			</div>
			@partials.Card("Update Ticket") {
				@TicketUpdateForm(ticket)
			}
			@partials.Card("Status History") {
				@TicketStatusHistory(ticket.StatusTransitions)
			}
		</div>
	}
}
