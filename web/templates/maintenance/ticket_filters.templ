package maintenanceviews

import (
	"dorm-man/web/templates/common/partials"
)

templ StaffTicketFilters() {
	<form
		method="GET"
		action="/maintenance/tickets"
		class={ partials.Cls.FilterBar }
	>
		@ticketFilterFields()
		<button
			type="submit"
			class={ partials.Cls.Button }
		>
			Filter
		</button>
	</form>
}

templ TenantTicketFilters() {
	<form
		method="GET"
		action="/tenant/tickets"
		class={ partials.Cls.FilterBar }
	>
		@ticketFilterFields()
		<button
			type="submit"
			class={ partials.Cls.Button }
		>
			Filter
		</button>
	</form>
}

templ ticketFilterFields() {
	<input
		type="date"
		name="from"
		class={ partials.Cls.Input }
	/>
	<input
		type="date"
		name="to"
		class={ partials.Cls.Input }
	/>
	<select
		name="status"
		class={ partials.Cls.Select }
	>
		<option value="">All Statuses</option>
		<option value="reported">Reported</option>
		<option value="duplicate">Duplicate</option>
		<option value="in_progress">In Progress</option>
		<option value="halted">Halted</option>
		<option value="resolved">Resolved</option>
		<option value="closed">Closed</option>
	</select>
	<select
		name="category"
		class={ partials.Cls.Select }
	>
		<option value="">All Categories</option>
		<option value="yearly">Yearly</option>
		<option value="monthly">Monthly</option>
		<option value="weekly">Weekly</option>
		<option value="incident">Incident</option>
	</select>
	<select
		name="severity"
		class={ partials.Cls.Select }
	>
		<option value="">All Severities</option>
		<option value="high">High</option>
		<option value="medium">Medium</option>
		<option value="low">Low</option>
	</select>
}
