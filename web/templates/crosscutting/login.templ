package platform

import "dorm-man/web/templates/common/components"

templ LoginPage(errorMessage string) {
	@components.Document("Login") {
		@LoginContent(errorMessage)
	}
}

templ LoginContent(errorMessage string) {
	<h1 class="mb-2 text-3xl font-bold">Platform Login</h1>
	<p class="mb-6 text-dm-muted">
		Sign in and get redirected to your module based on your role.
	</p>
	if errorMessage != "" {
		@components.ErrorAlert(errorMessage)
	}
	<form
		method="post"
		action="/home/login"
		class="flex max-w-xl flex-col gap-2"
		hx-post="/home/login"
		hx-swap="none"
	>
		<label
			for="login-nickname"
			class="text-sm font-medium text-dm-fg"
		>
			Nickname
		</label>
		<input
			id="login-nickname"
			name="nickname"
			type="text"
			required
			class="rounded border border-dm-border bg-dm-bg px-3 py-2 text-dm-fg focus:outline-2 focus:outline-offset-1 focus:outline-dm-focus"
		/>
		<label
			for="login-password"
			class="text-sm font-medium text-dm-fg"
		>
			Password
		</label>
		<input
			id="login-password"
			name="password"
			type="password"
			required
			class="rounded border border-dm-border bg-dm-bg px-3 py-2 text-dm-fg focus:outline-2 focus:outline-offset-1 focus:outline-dm-focus"
		/>
		<button
			type="submit"
			class="w-fit cursor-pointer rounded border border-dm-accent bg-dm-accent px-3 py-2 text-dm-on-accent hover:border-dm-accent-hover hover:bg-dm-accent-hover"
		>
			Login
		</button>
	</form>
}
