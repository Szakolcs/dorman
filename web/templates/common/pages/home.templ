package pages

import "dorm-man/web/templates/common/components"

templ HomePage() {
	@components.AppDocument("Dormitory Manager", HomeContent())
}

templ HomeContent() {
	@components.PageHeader(
		"Dormitory Manager",
		"Multipage HTMX + Templ workspace for dormitory operations.",
	)
	<ul class="list-disc space-y-1 pl-6">
		<li><a href="/forum/view" hx-boost="true">Forum</a></li>
		<li><a href="/chat/view" hx-boost="true">Chat</a></li>
		<li><a href="/doorman" hx-boost="true">Doorman</a></li>
		<li><a href="/administration" hx-boost="true">Administration</a></li>
		<li><a href="/about" hx-boost="true">About</a></li>
	</ul>
}
