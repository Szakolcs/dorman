package partials

templ ThemeToggle() {
	<button
		type="button"
		class="cursor-pointer rounded border border-dm-border bg-dm-surface px-2 py-1 text-sm text-dm-muted hover:border-dm-accent hover:text-dm-fg"
		data-theme-toggle-label
		onclick="dmCycleTheme()"
		aria-label="Cycle theme: system, light, dark"
	>
		Theme
	</button>
}

templ BaseNav() {
	<nav class="mb-6 flex flex-wrap items-center gap-2 gap-x-4 rounded-lg border border-dm-border bg-dm-elevated px-4 py-2">
		{ children... }
		<span class="ml-auto">
			@ThemeToggle()
		</span>
	</nav>
}