package partials

templ NavLink(href string, label string) {
	<a href={ templ.URL(href) } class={ Cls.NavLink }>
		{ label }
	</a>
}

templ ThemeToggle() {
	<button
		type="button"
		class={ Cls.NavButton }
		data-theme-toggle-label
		onclick="dmCycleTheme()"
		aria-label="Cycle theme: system, light, dark"
	>
		Theme
	</button>
}

templ LogoutButton() {
	<form class="m-0 inline" hx-post="/home/logout" hx-swap="none">
		<button type="submit" class={ Cls.NavButtonDanger }>
			Logout
		</button>
	</form>
}

templ BaseNav() {
	<nav class={ Cls.Nav }>
		{ children... }
		<span class={ Cls.NavActions }>
			@ThemeToggle()
			@LogoutButton()
		</span>
	</nav>
}
