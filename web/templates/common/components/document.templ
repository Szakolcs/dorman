package components

import "dorm-man/web/templates/common/partials"

// HtmxCDN is the shared HTMX version used across interactive pages.
const HtmxCDN = "https://unpkg.com/htmx.org@2.0.4"

templ Document(title string, body templ.Component) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<script src="/static/css/theme.js"></script>
			<link rel="stylesheet" href="/static/css/nord-palette.css"/>
			<link rel="stylesheet" href="/static/css/theme.css"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src={ HtmxCDN }></script>
		</head>
		<body class="app">
			<main class="app-main">
				@body
			</main>
		</body>
	</html>
}

// AppDocument is the standard full page shell: HTMX, global nav, then page content.
templ AppDocument(title string, body templ.Component) {
	@Document(title, AppPageBody(body))
}

templ AppPageBody(body templ.Component) {
	@partials.MainNav()
	@body
}

// DevActorField is a development stub control included in HTMX requests via hx-include.
templ DevActorField(barID string, label string, inputID string, inputName string, value string) {
	<div id={ barID } class="dev-actor">
		<p>{ label }</p>
		<label for={ inputID }>Actor ID</label>
		<input type="text" id={ inputID } name={ inputName } value={ value }/>
	</div>
}


templ PageHeader(title string, description string) {
	<header class="page-header">
		<h1>{ title }</h1>
		<p>{ description }</p>
	</header>
}

templ Section(title string, body templ.Component) {
	<section class="section">
		<h2>{ title }</h2>
		@body
	</section>
}

templ DataTable(headers []string, body templ.Component) {
	<table class="table">
		<thead>
			<tr>
				for _, header := range headers {
					<th>{ header }</th>
				}
			</tr>
		</thead>
		<tbody>
			@body
		</tbody>
	</table>
}

templ BackLink(href string, label string) {
	<p class="back-link"><a href={ templ.SafeURL(href) } hx-boost="true">{ label }</a></p>
}

templ ErrorAlert(message string) {
	<p class="alert alert--error" role="alert">{ message }</p>
}
