package components

import "dorm-man/web/templates/common/partials"

const HtmxCDN = "https://unpkg.com/htmx.org@2.0.4"

templ Document(title string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<script src="/static/css/theme.js"></script>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src={ HtmxCDN }></script>
		</head>
		<body>
			<main class="mx-auto max-w-6xl px-4 py-6 pb-8 md:px-6">
				{ children... }
			</main>
		</body>
	</html>
}

templ ErrorAlert(message string) {
	<p
		class="my-4 rounded border border-dm-error bg-dm-error/10 px-4 py-2 text-dm-error"
		role="alert"
	>
		{ message }
	</p>
}
